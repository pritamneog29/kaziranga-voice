{
  "expo": {
    "name": "Kaziranga Voice",
    "slug": "kaziranga-voice",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "kazirangavoice",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kazirangavoice.app",
      "infoPlist": {
        "NSCameraUsageDescription": "To photograph your offline letter for record-keeping.",
        "NSPhotoLibraryUsageDescription": "To attach photos of your offline letter."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1B5E20",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.kazirangavoice.app",
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "To photograph your offline letter for record-keeping."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "To attach photos of your offline letter."
        }
      ],
      "expo-mail-composer",
      "expo-web-browser"
    ]
  }
}
